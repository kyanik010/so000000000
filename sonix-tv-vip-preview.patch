+
+    /* ==========================================================================
+       SONIX PROFESSIONAL ITEM PREVIEW PANEL (Below Video Viewport)
+       ========================================================================== */
+    .sonix-preview-panel {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      flex: 1 1 auto;
+      min-height: 0;
+      width: 100%;
+      background: rgba(14, 20, 28, 0.78);
+      border: 1px solid var(--border-panel);
